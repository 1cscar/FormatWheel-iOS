    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式轮盘会把转换好的图片和视频存到相册（可在设置里关闭）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式輪盤會把轉換好的照片和影片存到相簿（可在設定中關閉）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FormatWheel saves converted photos and videos to your library (you can turn this off in Settings)."
          }
        }
      }
    }
  }
