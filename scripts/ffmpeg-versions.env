# Pinned versions for scripts/build-ffmpeg.sh and scripts/fetch-ffmpeg.sh.
# Changing any of these requires re-running the "FFmpeg xcframeworks" workflow (.github/workflows/ffmpeg.yml).
FFMPEG_VERSION=9.0.2
LAME_VERSION=3.100
OPUS_VERSION=1.6.1
LIBVPX_VERSION=1.17.0
LIBWEBP_VERSION=1.6.0
SVTAV1_VERSION=4.3.0
IOS_MIN=17.0
# GitHub Release that caches the prebuilt xcframeworks.
FFMPEG_TAG=ffmpeg-v${FFMPEG_VERSION}
